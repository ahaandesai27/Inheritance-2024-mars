# Atlas connection string. The Backend uses the same cluster - see Backend/.env (DATABASE_URI).
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGO_DB=RecipAura
RECIPE_COLLECTION=recipes
VECTOR_INDEX_NAME=recipe_vector_index

# Redis, used to cache recommendation results.
REDIS_URL=redis://127.0.0.1:6379

HOST=0.0.0.0
PORT=8080

# Optional overrides
# DATA_PATH=./data/recipes.json
# MODEL_WEIGHTS_PATH=./model/model.pt
# RECOMMENDATION_CACHE_TTL=86400
